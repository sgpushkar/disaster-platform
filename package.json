{
  "name": "disaster-platform",
  "version": "1.0.0",
  "description": "Full-stack disaster prediction platform",
  "type": "module",
  "scripts": {
    "setup": "node setup.js",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue.bold,cyan.bold\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "node start-backend.js",
    "dev:frontend": "npm --prefix frontend run dev",
    "train:all": "node -e \"import('./setup.js').then(m => m.trainModels())\"",
    "build": "cd frontend && npm install && npm run build",
    "preview": "npm --prefix frontend run preview",
    "install:all": "npm install && npm --prefix frontend install",
    "android:build": "npm --prefix frontend run build:android",
    "android:open": "npx --prefix frontend cap open android"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
