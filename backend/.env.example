# Rename this file to .env and fill in real values

# Security
SECRET_KEY=change_this_to_a_long_random_string_before_deploying
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
DATABASE_URL=sqlite:///./database/disaster.db

# OpenWeatherMap - get a free key at https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweathermap_api_key_here
OPENWEATHER_DEFAULT_LAT=19.0760
OPENWEATHER_DEFAULT_LON=72.8777

# CORS
FRONTEND_ORIGIN=http://localhost:5173
